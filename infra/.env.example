# Copy to infra/.env and fill in. Never commit infra/.env.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas

# LiteLLM gateway (~/deploy/ai-gateway); key lives in that stack's secrets
ATLAS_LLM_BASE_URL=http://ai-gateway:4000/v1
ATLAS_LLM_API_KEY=

# Super admin login (login page: email + password). Store only an argon2 hash.
ATLAS_SUPERADMIN_EMAIL=
ATLAS_SUPERADMIN_PASSWORD_HASH=
