# Copy to infra/.env and fill in. Never commit infra/.env.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas

# LiteLLM gateway (~/deploy/ai-gateway); key lives in that stack's secrets
ATLAS_LLM_BASE_URL=http://ai-gateway:4000/v1
ATLAS_LLM_API_KEY=

# Super admin login (login page: email + password). Store only an argon2 hash.
ATLAS_SUPERADMIN_EMAIL=
ATLAS_SUPERADMIN_PASSWORD_HASH=
# Signs the super admin cookie: openssl rand -hex 32
ATLAS_SESSION_SECRET=

# LangSmith tracing (docs/RAG_GUIDE.md "How to turn on LangSmith"). Leave the key empty and
# tracing stays off. EU workspaces use https://eu.api.smith.langchain.com as the endpoint.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Clerk Backend API key (Phase 10 waitlist). sk_test_ for the development instance, sk_live_ at launch.
CLERK_SECRET_KEY=
